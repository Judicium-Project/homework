{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eirikaleid/homework/review.schema.json",
  "title": "homework layer-2 reviewer answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "items", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["complete", "incomplete", "wrong"]},
    "summary": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence", "note"],
        "properties": {
          "criterion": {"type": "string"},
          "status": {"type": "string", "enum": ["done", "partial", "missing", "wrong", "unverifiable"]},
          "evidence": {"type": ["string", "null"], "description": "file:line in the new version of the diff, or null"},
          "note": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "severity", "file", "line", "message"],
        "properties": {
          "kind": {"type": "string", "enum": ["half-done", "scope-creep", "wrong-behavior", "other"]},
          "severity": {"type": "string", "enum": ["error", "warning", "info"]},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]},
          "message": {"type": "string"}
        }
      }
    }
  }
}
