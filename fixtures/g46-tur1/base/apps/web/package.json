{
  "name": "@chatapp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatApp web istemcisi (Beta 0 / Z5a + Z5b)",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite --port 5410 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e && node ../../packages/tokens/scripts/ham-deger-yasak.mjs src",
    "e2e": "node e2e/smoke.mjs",
    "pretest": "test -f ../../packages/tokens/dist/tokens.css || pnpm --filter @chatapp/tokens build",
    "prebuild": "test -f ../../packages/tokens/dist/tokens.css || pnpm --filter @chatapp/tokens build",
    "prelint": "test -f ../../packages/tokens/dist/tokens.css || pnpm --filter @chatapp/tokens build",
    "e2e:voice": "node e2e/voice.mjs",
    "e2e:kurulum": "playwright test kurulum.spec.ts",
    "e2e:beta0": "playwright test beta0.spec.ts",
    "e2e:hesap": "playwright test hesap.spec.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-virtual": "3.14.15",
    "@chatapp/api-types": "workspace:*",
    "@chatapp/tokens": "workspace:*",
    "livekit-client": "2.22.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
