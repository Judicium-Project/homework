diff --git a/apps/web/src/ui/floating.ts b/apps/web/src/ui/floating.ts
new file mode 100644
index 0000000..34e9477
--- /dev/null
+++ b/apps/web/src/ui/floating.ts
@@ -0,0 +1,91 @@
+import { useEffect } from "react";
+import {
+  useFloating,
+  autoUpdate,
+  flip,
+  shift,
+  size,
+  offset,
+  type Placement,
+  type Strategy,
+  type VirtualElement,
+} from "@floating-ui/react";
+
+export type FloatingReference =
+  | HTMLElement
+  | VirtualElement
+  | DOMRect
+  | { getBoundingClientRect: () => DOMRect }
+  | null
+  | undefined;
+
+export interface UseAppFloatingOptions {
+  reference?: FloatingReference;
+  placement?: Placement;
+  strategy?: Strategy;
+  offsetPx?: number;
+  padding?: number;
+  open?: boolean;
+}
+
+/** DOMRect veya getBoundingClientRect taşıyan nesneyi Floating UI VirtualElement'e dönüştürür. */
+export function toVirtualElement(r: DOMRect | { getBoundingClientRect: () => DOMRect } | VirtualElement): VirtualElement {
+  if ("getBoundingClientRect" in r && typeof r.getBoundingClientRect === "function") {
+    return {
+      getBoundingClientRect: () => r.getBoundingClientRect(),
+    };
+  }
+  return {
+    getBoundingClientRect: () => r as DOMRect,
+  };
+}
+
+/**
+ * ChatApp tekil konumlama yardımcısı (PLAN-C N5).
+ * flip + shift + size (sığmazsa iç kaydırma) + autoUpdate ile çalışır.
+ */
+export function useAppFloating(options: UseAppFloatingOptions = {}) {
+  const {
+    reference,
+    placement = "bottom-start",
+    strategy = "fixed",
+    offsetPx = 4,
+    padding = 8,
+    open = true,
+  } = options;
+
+  const floating = useFloating({
+    placement,
+    strategy,
+    open,
+    whileElementsMounted: autoUpdate,
+    middleware: [
+      offset(offsetPx),
+      flip({ padding }),
+      shift({ padding }),
+      size({
+        padding,
+        apply({ availableWidth, availableHeight, elements }) {
+          Object.assign(elements.floating.style, {
+            maxWidth: `${Math.max(0, Math.floor(availableWidth))}px`,
+            maxHeight: `${Math.max(0, Math.floor(availableHeight))}px`,
+          });
+        },
+      }),
+    ],
+  });
+
+  // reference prop'u verildiğinde floating refs ile eşle
+  useEffect(() => {
+    if (!reference) return;
+    if ("nodeType" in reference) {
+      floating.refs.setReference(reference as HTMLElement);
+    } else {
+      floating.refs.setReference(toVirtualElement(reference));
+    }
+  }, [reference, floating.refs]);
+
+  return floating;
+}
+
+export { autoUpdate, flip, shift, size, offset };
