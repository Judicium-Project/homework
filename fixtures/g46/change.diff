@@ -0,0 +1,86 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MenuHost, openMenu, openMenuAt, type MenuItem } from "./Menu.tsx";
+
+describe("Menu (PLAN-C N5 Konumlama)", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("openMenuAt ile tetikleyici düğmenin yanında menü açılır ve seçilince kapanır", async () => {
+    const onSelect = vi.fn();
+    const items: MenuItem[] = [
+      { label: "İşlem 1", onSelect },
+      { label: "İşlem 2", onSelect: vi.fn(), disabled: true },
+    ];
+
+    render(
+      <div>
+        <button
+          type="button"
+          onClick={(e) => openMenuAt(e.currentTarget, items)}
+        >
+          Seçenekler
+        </button>
+        <MenuHost />
+      </div>,
+    );
+
+    const btn = screen.getByRole("button", { name: "Seçenekler" });
+    await userEvent.click(btn);
+
+    await waitFor(() => {
+      expect(screen.getByRole("menu")).toBeInTheDocument();
+    });
+
+    const item1 = screen.getByRole("menuitem", { name: "İşlem 1" });
+    await userEvent.click(item1);
+
+    expect(onSelect).toHaveBeenCalled();
+    await waitFor(() => {
+      expect(screen.queryByRole("menu")).not.toBeInTheDocument();
+    });
+  });
+
+  it("ekranın 4 köşesinde openMenu çağrıldığında menü DOM'a eklenir ve taşmaz", async () => {
+    const items: MenuItem[] = [
+      { label: "Köşe İşlemi 1", onSelect: vi.fn() },
+      { label: "Köşe İşlemi 2", onSelect: vi.fn() },
+    ];
+
+    const { rerender } = render(
+      <div>
+        <MenuHost />
+      </div>,
+    );
+
+    // 4 köşe koordinatları: sol-üst, sağ-üst, sol-alt, sağ-alt
+    const corners = [
+      { x: 10, y: 10 },
+      { x: 380, y: 10 },
+      { x: 10, y: 800 },
+      { x: 380, y: 800 },
+    ];
+
+    for (const corner of corners) {
+      openMenu({ clientX: corner.x, clientY: corner.y }, items);
+      rerender(
+        <div>
+          <MenuHost />
+        </div>,
+      );
+
+      await waitFor(() => {
+        const menu = screen.getByRole("menu");
+        expect(menu).toBeInTheDocument();
+      });
+
+      // Esc ile kapat
+      await userEvent.keyboard("{Escape}");
+      await waitFor(() => {
+        expect(screen.queryByRole("menu")).not.toBeInTheDocument();
+      });
+    }
+  });
+});
