index 0000000..7a66172
--- /dev/null
+++ b/apps/web/src/features/settings/ChannelSettings.test.tsx
@@ -0,0 +1,181 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { render, screen, fireEvent, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { ChannelType } from "@chatapp/api-types";
+import { useStore } from "../../store/index.ts";
+import { ChannelSettingsModal } from "./ChannelSettings.tsx";
+import { api } from "../../api/endpoints.ts";
+
+vi.mock("../../api/endpoints.ts", () => ({
+  api: {
+    updateChannel: vi.fn().mockResolvedValue({ id: "c1", name: "yeni-kanal" }),
+    putOverwrite: vi.fn().mockResolvedValue({}),
+    deleteOverwrite: vi.fn().mockResolvedValue({}),
+  },
+}));
+
+describe("ChannelSettingsModal (PLAN-C N1)", () => {
+  const guildId = "g1";
+  const channelId = "c1";
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+    useStore.setState({
+      me: {
+        id: "u1",
+        username: "testuser",
+        display_name: "Test Kullanıcı",
+        avatar_id: null,
+        banner_id: null,
+        about: null,
+        bot: false,
+        email: "test@example.com",
+        email_verified: true,
+        instance_admin: false,
+        date_of_birth: "1995-01-01",
+        locale: "tr",
+      },
+      guilds: {
+        g1: {
+          id: "g1",
+          name: "Test Sunucu",
+          iconId: null,
+          ownerId: "u1",
+          systemChannelId: null,
+          defaultNotifications: 0,
+          memberCount: 1,
+          joinedAt: null,
+          channels: {
+            c1: {
+              id: "c1",
+              guild_id: "g1",
+              name: "genel",
+              type: ChannelType.GUILD_TEXT,
+              topic: "Eski Konu",
+              position: 0,
+              parent_id: null,
+              permission_overwrites: [],
+              bitrate: null,
+              user_limit: null,
+              last_message_id: null,
+            },
+          },
+          roles: {
+            g1: {
+              id: "g1",
+              name: "@everyone",
+              color: 0,
+              hoist: false,
+              position: 0,
+              permissions: "0",
+              mentionable: false,
+            },
+          },
+          members: {},
+        },
+      },
+    });
+  });
+
+  it("ad değiştir → kaydet → onClose çağrılır", async () => {
+    const onClose = vi.fn();
+    render(<ChannelSettingsModal guildId={guildId} channelId={channelId} onClose={onClose} />);
+
+    const input = screen.getByLabelText("Kanal adı");
+    expect(input).toHaveValue("genel");
+
+    await userEvent.clear(input);
+    await userEvent.type(input, "yeni-kanal");
+    expect(input).toHaveValue("yeni-kanal");
+
+    const saveBtn = screen.getByRole("button", { name: "Kaydet" });
+    await userEvent.click(saveBtn);
+
+    await waitFor(() => {
+      expect(api.updateChannel).toHaveBeenCalledWith("c1", expect.objectContaining({ name: "yeni-kanal" }));
+      expect(onClose).toHaveBeenCalled();
+    });
+  });
+
+  it("kirli formda Esc → onay iletişimi açılır (Kaydet / Kaydetmeden çık / Vazgeç)", async () => {
+    const onClose = vi.fn();
+    render(<ChannelSettingsModal guildId={guildId} channelId={channelId} onClose={onClose} />);
+
+    const input = screen.getByLabelText("Kanal adı");
+    await userEvent.type(input, "-ek");
+
+    // Esc tuşuna bas
+    fireEvent.keyDown(window, { key: "Escape" });
+
+    // Onay iletişimi açılmalı, doğrudan kapanmamalı
+    expect(onClose).not.toHaveBeenCalled();
+
+    await waitFor(() => {
+      expect(screen.getByText("Değişiklikler kaydedilsin mi?")).toBeInTheDocument();
+    });
+
+    const discardBtn = screen.getByRole("button", { name: "Kaydetmeden çık" });
+    const cancelBtn = screen.getByRole("button", { name: "Vazgeç" });
+    const confirmSaveBtn = screen.getAllByRole("button", { name: "Kaydet" }).find((btn) => btn.closest('[role="dialog"]'));
+
+    expect(discardBtn).toBeInTheDocument();
+    expect(cancelBtn).toBeInTheDocument();
+    expect(confirmSaveBtn).toBeInTheDocument();
+
+    // Vazgeç tıklanırsa onay diyaloğu kapanır, formda kalınır
+    await userEvent.click(cancelBtn);
+    await waitFor(() => {
+      expect(screen.queryByText("Değişiklikler kaydedilsin mi?")).not.toBeInTheDocument();
+    });
+    expect(onClose).not.toHaveBeenCalled();
+
+    // Tekrar Esc bas ve Kaydetmeden çık tıkla
+    fireEvent.keyDown(window, { key: "Escape" });
+    await waitFor(() => {
+      expect(screen.getByText("Değişiklikler kaydedilsin mi?")).toBeInTheDocument();
+    });
+
+    const discardAgain = screen.getByRole("button", { name: "Kaydetmeden çık" });
+    await userEvent.click(discardAgain);
+
+    expect(onClose).toHaveBeenCalled();
+  });
+
+  it("kirli formda onay iletişiminde 'Kaydet' tıklandığında kaydeder ve kapatır", async () => {
+    const onClose = vi.fn();
+    render(<ChannelSettingsModal guildId={guildId} channelId={channelId} onClose={onClose} />);
+
+    const input = screen.getByLabelText("Kanal adı");
+    await userEvent.type(input, "-test");
+
+    // Esc ile onay diyaloğunu aç
+    fireEvent.keyDown(window, { key: "Escape" });
+    await waitFor(() => {
+      expect(screen.getByText("Değişiklikler kaydedilsin mi?")).toBeInTheDocument();
+    });
+
+    // Diyalogdaki Kaydet düğmesine bas
+    const dialog = screen.getByRole("dialog", { name: "Değişiklikler kaydedilsin mi?" });
+    const saveInDialog = dialog.querySelector('button[data-autofocus]') as HTMLElement;
+    expect(saveInDialog).toBeInTheDocument();
+    await userEvent.click(saveInDialog);
+
+    await waitFor(() => {
+      expect(api.updateChannel).toHaveBeenCalled();
+      expect(onClose).toHaveBeenCalled();
+    });
+  });
+
+  it("temiz formda Esc basılınca onay sormadan doğrudan kapanır", async () => {
+    const onClose = vi.fn();
+    render(<ChannelSettingsModal guildId={guildId} channelId={channelId} onClose={onClose} />);
+
+    // Form temizken Esc bas
+    fireEvent.keyDown(window, { key: "Escape" });
+
+    await waitFor(() => {
+      expect(onClose).toHaveBeenCalled();
+    });
+    expect(screen.queryByText("Değişiklikler kaydedilsin mi?")).not.toBeInTheDocument();
+  });
+});
