diff --git a/apps/web/src/ui/useDirtyCloseGuard.tsx b/apps/web/src/ui/useDirtyCloseGuard.tsx
new file mode 100644
index 0000000..ba714cb
--- /dev/null
+++ b/apps/web/src/ui/useDirtyCloseGuard.tsx
@@ -0,0 +1,120 @@
+import { useCallback, useEffect, useState, type ReactNode } from "react";
+import { Modal } from "./Modal.tsx";
+import { Button } from "./Button.tsx";
+import { t } from "../i18n/index.ts";
+
+export interface DirtyCloseGuardOptions {
+  isDirty: boolean;
+  onClose: () => void;
+  onSave?: () => Promise<boolean | void> | boolean | void;
+}
+
+export interface UseDirtyCloseGuardReturn {
+  requestClose: () => void;
+  showPrompt: boolean;
+  setShowPrompt: (open: boolean) => void;
+  guardModal: ReactNode;
+}
+
+/**
+ * ChatApp kirli form kapatma koruma kancası (PLAN-C N1).
+ * Esc / kapat tetiklendiğinde form kirliyse onay iletişimi çıkar:
+ * "Değişiklikler kaydedilsin mi?" (Kaydet / Kaydetmeden çık / Vazgeç).
+ */
+export function useDirtyCloseGuard({
+  isDirty,
+  onClose,
+  onSave,
+}: DirtyCloseGuardOptions): UseDirtyCloseGuardReturn {
+  const [showPrompt, setShowPrompt] = useState(false);
+  const [saving, setSaving] = useState(false);
+
+  const requestClose = useCallback(() => {
+    if (isDirty) {
+      setShowPrompt(true);
+    } else {
+      onClose();
+    }
+  }, [isDirty, onClose]);
+
+  // Esc tuşu dinleyicisi: temiz formda kapatır, kirli formda onay açar
+  useEffect(() => {
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === "Escape" && !e.defaultPrevented) {
+        e.preventDefault();
+        e.stopPropagation();
+        if (showPrompt) {
+          setShowPrompt(false);
+          return;
+        }
+        if (isDirty) {
+          setShowPrompt(true);
+        } else {
+          onClose();
+        }
+      }
+    };
+
+    document.addEventListener("keydown", handleKeyDown, true);
+    window.addEventListener("keydown", handleKeyDown, true);
+    return () => {
+      document.removeEventListener("keydown", handleKeyDown, true);
+      window.removeEventListener("keydown", handleKeyDown, true);
+    };
+  }, [isDirty, showPrompt, onClose]);
+
+  const handleDiscard = useCallback(() => {
+    setShowPrompt(false);
+    onClose();
+  }, [onClose]);
+
+  const handleCancel = useCallback(() => {
+    setShowPrompt(false);
+  }, []);
+
+  const handleSave = useCallback(async () => {
+    if (!onSave) {
+      handleDiscard();
+      return;
+    }
+    setSaving(true);
+    try {
+      const res = await onSave();
+      if (res !== false) {
+        setShowPrompt(false);
+        onClose();
+      }
+    } finally {
+      setSaving(false);
+    }
+  }, [onSave, handleDiscard, onClose]);
+
+  const guardModal = showPrompt ? (
+    <Modal
+      title={t("settings.dirty.title")}
+      description={t("settings.dirty.desc")}
+      onClose={handleCancel}
+      size="sm"
+      actions={
+        <>
+          <Button onClick={handleCancel} disabled={saving}>
+            {t("common.cancel")}
+          </Button>
+          <Button kind="danger" onClick={handleDiscard} disabled={saving}>
+            {t("settings.dirty.discard")}
+          </Button>
+          <Button kind="primary" busy={saving} onClick={() => void handleSave()} data-autofocus>
+            {t("common.save")}
+          </Button>
+        </>
+      }
+    />
+  ) : null;
+
+  return {
+    requestClose,
+    showPrompt,
+    setShowPrompt,
+    guardModal,
+  };
+}
