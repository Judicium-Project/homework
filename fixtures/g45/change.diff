+	if admin == "" {
+		admin = "postgres://chatapp@127.0.0.1:54320/chatapp?sslmode=disable"
+	}
+	conn, err := pgx.Connect(ctx, admin)
+	if err != nil {
+		t.Fatalf("PG yok: %v", err)
+	}
+	defer conn.Close(ctx)
+	_, _ = conn.Exec(ctx, "DROP DATABASE IF EXISTS chatapp_limit_mig_test")
+	if _, err := conn.Exec(ctx, "CREATE DATABASE chatapp_limit_mig_test"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		c, err := pgx.Connect(context.Background(), admin)
+		if err == nil {
+			_, _ = c.Exec(context.Background(), "DROP DATABASE IF EXISTS chatapp_limit_mig_test WITH (FORCE)")
+			_ = c.Close(context.Background())
+		}
+	})
+
+	pool, err := Open(ctx, "postgres://chatapp@127.0.0.1:54320/chatapp_limit_mig_test?sslmode=disable")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	log := slog.New(slog.NewTextHandler(io.Discard, nil))
+
+	// 1. En son sürüme migrate up yap
+	if err := Migrate(ctx, pool, MigrateUp, io.Discard, log); err != nil {
