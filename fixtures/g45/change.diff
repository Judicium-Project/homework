@@ -0,0 +1,75 @@
+package message
+
+import (
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/eirikaleid/chatapp/services/chatapp/internal/api"
+	"github.com/eirikaleid/chatapp/services/chatapp/internal/api/gen"
+)
+
+func TestValidateContent_Limits(t *testing.T) {
+	// 1. 4000 karakterlik metin kabul edilmeli
+	msg4000 := strings.Repeat("a", 4000)
+	if err := validateContent(msg4000, false); err != nil {
+		t.Fatalf("4000 ASCII karakter kabul edilmeliydi: %v", err)
+	}
+
+	// 2. 4000 emoji (çok baytlı Unicode, 16000 bayt) kabul edilmeli
+	emoji4000 := strings.Repeat("😀", 4000)
+	if err := validateContent(emoji4000, false); err != nil {
+		t.Fatalf("4000 emoji kabul edilmeliydi: %v", err)
+	}
+
+	// 3. 4001 rune -> 422 TOO_LONG, max=4000, actual=4001
+	msg4001 := strings.Repeat("a", 4001)
+	err := validateContent(msg4001, false)
+	if err == nil {
+		t.Fatal("4001 rune hata vermeliydi")
+	}
+
+	var apiErr *api.Error
+	if !errors.As(err, &apiErr) {
+		t.Fatalf("beklenen *api.Error, alınan %T", err)
+	}
+	if apiErr.Status != http.StatusUnprocessableEntity {
+		t.Errorf("beklenen durum 422, alınan %d", apiErr.Status)
+	}
+	if apiErr.Code != gen.ErrorCodeVALIDATIONFAILED {
+		t.Errorf("beklenen kod VALIDATION_FAILED, alınan %s", apiErr.Code)
+	}
+	if len(apiErr.Fields) != 1 {
+		t.Fatalf("beklenen 1 alan hatası, alınan %d", len(apiErr.Fields))
+	}
+	f := apiErr.Fields[0]
+	if f.Field != "content" {
+		t.Errorf("beklenen alan 'content', alınan '%s'", f.Field)
+	}
+	if f.Code != "TOO_LONG" {
+		t.Errorf("beklenen alan kodu 'TOO_LONG', alınan '%s'", f.Code)
+	}
+	if f.Max == nil || *f.Max != 4000 {
+		t.Errorf("beklenen max=4000, alınan %v", f.Max)
+	}
+	if f.Actual == nil || *f.Actual != 4001 {
+		t.Errorf("beklenen actual=4001, alınan %v", f.Actual)
+	}
+
+	// 4. 4001 emoji -> 422 TOO_LONG, max=4000, actual=4001
+	emoji4001 := strings.Repeat("😀", 4001)
+	errEmoji := validateContent(emoji4001, false)
+	if errEmoji == nil {
+		t.Fatal("4001 emoji hata vermeliydi")
+	}
+	if errors.As(errEmoji, &apiErr) {
+		fEmoji := apiErr.Fields[0]
+		if fEmoji.Max == nil || *fEmoji.Max != 4000 {
+			t.Errorf("beklenen max=4000, alınan %v", fEmoji.Max)
+		}
+		if fEmoji.Actual == nil || *fEmoji.Actual != 4001 {
+			t.Errorf("beklenen actual=4001, alınan %v", fEmoji.Actual)
+		}
+	}
+}
