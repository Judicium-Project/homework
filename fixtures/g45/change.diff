--- /dev/null
+++ b/services/chatapp/internal/platform/db/migrations/00017_message_content_limit.sql
@@ -0,0 +1,18 @@
+-- 00017_message_content_limit.sql: Mesaj içerik uzunluk CHECK sınırını 16000'e gevşet (tavan; K64, N3/N4).
+-- +goose Up
+-- +goose StatementBegin
+ALTER TABLE messages DROP CONSTRAINT IF EXISTS messages_content_check;
+ALTER TABLE messages ADD CONSTRAINT messages_content_check CHECK (char_length(content) <= 16000);
+-- +goose StatementEnd
+
+-- +goose Down
+-- +goose StatementBegin
+DO $$
+BEGIN
+    IF EXISTS (SELECT 1 FROM messages WHERE char_length(content) > 4000) THEN
+        RAISE EXCEPTION 'cannot rollback migration: messages with content length > 4000 exist';
+    END IF;
+END $$;
