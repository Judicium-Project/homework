+++ b/apps/web/src/features/shell/VoiceCard.test.tsx
@@ -0,0 +1,152 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router";
+import { useStore } from "../../store/index.ts";
+import { useVoice, voice } from "../../voice/index.ts";
+import { useRoom } from "../../voice/engine.ts";
+import { VoiceCard } from "./VoiceCard.tsx";
+
+describe("VoiceCard (G32 · Sol sütun ses kartı)", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    useVoice.setState({
+      status: "connected",
+      guildId: "g1",
+      channelId: "c1",
+      selfMute: false,
+      selfDeaf: false,
+      capabilities: { camera: true, screenShare: true, stats: true },
+      session: null,
+      pingMs: null,
+      error: null,
+    });
+    useRoom.setState({
+      permError: null,
+      streams: [],
+      participants: [
+        { userId: "u1", camSid: null, local: true, micOn: true, conn: "good" },
+        { userId: "u2", camSid: null, local: false, micOn: true, conn: "good" },
+      ],
+    });
+    useStore.setState({
+      me: {
+        id: "u1",
+        username: "testuser",
+        display_name: "Test User",
+        avatar_id: null,
+        banner_id: null,
+        about: null,
+        bot: false,
+        email: "test@example.com",
+        email_verified: true,
+        instance_admin: false,
+        date_of_birth: "2000-01-01",
+        locale: "tr",
+      },
+      guilds: {
+        g1: {
+          id: "g1",
+          name: "Deneme Sunucusu",
+          iconId: null,
+          ownerId: "u1",
+          systemChannelId: null,
+          defaultNotifications: 0,
+          memberCount: 2,
+          joinedAt: null,
+          roles: {},
+          members: {
+            u1: {
+              user: { id: "u1", username: "testuser", display_name: "Test User", avatar_id: null, banner_id: null, about: null, bot: false },
+              nick: "Test User",
+              avatar_id: null,
+              roles: [],
+              joined_at: "",
+              deaf: false,
+              mute: false,
+            },
+            u2: {
+              user: { id: "u2", username: "diger", display_name: "Diğer Kişi", avatar_id: null, banner_id: null, about: null, bot: false },
+              nick: "Diğer Kişi",
+              avatar_id: null,
+              roles: [],
+              joined_at: "",
+              deaf: false,
+              mute: false,
+            },
+          },
+          channels: {
+            c1: {
+              id: "c1",
+              guild_id: "g1",
+              type: 2,
+              name: "Sohbet Odası",
+              topic: null,
+              position: 0,
+              parent_id: null,
+              permission_overwrites: [],
+              bitrate: 64,
+              user_limit: null,
+              last_message_id: null,
+            },
+          },
+        },
+      },
+      voiceStates: {
+        g1: {
+          u1: { guild_id: "g1", channel_id: "c1", user_id: "u1", session_id: "s1", self_mute: false, self_deaf: false, mute: false, deaf: false, self_video: false, self_stream: false },
+          u2: { guild_id: "g1", channel_id: "c1", user_id: "u2", session_id: "s2", self_mute: false, self_deaf: false, mute: false, deaf: false, self_video: false, self_stream: false },
+        },
+      },
+    });
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("ses bağlıyken kart 3 ikon düğmeyi aria-label ile içerir; katılımcı listesi yok; Ayrıl tıklanınca voice.leave çağrılır", () => {
+    const leaveSpy = vi.spyOn(voice, "leave").mockResolvedValue();
+
+    render(
+      <MemoryRouter>
+        <VoiceCard />
+      </MemoryRouter>,
+    );
+
+    // Kart görünür
+    expect(screen.getByTestId("voice-card")).toBeInTheDocument();
+
+    // Durum ve kanal adı
+    expect(screen.getByText("Ses bağlı")).toBeInTheDocument();
+    expect(screen.getByText("Sohbet Odası")).toBeInTheDocument();
+
+    // 3 ikon düğme aria-label ile var
+    const micBtn = screen.getByRole("button", { name: "Mikrofonu kapat" });
+    const shareBtn = screen.getByRole("button", { name: "Ekranı paylaş" });
+    const leaveBtn = screen.getByRole("button", { name: "Ayrıl" });
+
+    expect(micBtn).toBeInTheDocument();
+    expect(shareBtn).toBeInTheDocument();
+    expect(leaveBtn).toBeInTheDocument();
+
+    // Katılımcı listesi yok (kanal listesinde yer alır, kartta tekrarlanmaz)
+    expect(screen.queryByText("Diğer Kişi")).toBeNull();
+    expect(screen.queryByText("Test User")).toBeNull();
+
+    // Ayrıl tıklanınca voice.leave çağrılır
+    fireEvent.click(leaveBtn);
+    expect(leaveSpy).toHaveBeenCalledOnce();
+  });
+
+  it("ses bağlı değilken kart render edilmez", () => {
+    useVoice.setState({ status: "idle", channelId: null });
+
+    render(
+      <MemoryRouter>
+        <VoiceCard />
+      </MemoryRouter>,
+    );
+
+    expect(screen.queryByTestId("voice-card")).toBeNull();
+  });
+});
